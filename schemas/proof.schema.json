{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "proof",
  "type": "object",
  "required": [
    "patch_id",
    "finding_id",
    "n_replayed",
    "agreement_rate",
    "cost_before_month_usd",
    "cost_after_month_usd",
    "p95_before_ms",
    "p95_after_ms",
    "threshold",
    "verdict"
  ],
  "properties": {
    "patch_id": {
      "type": "string"
    },
    "finding_id": {
      "type": "string"
    },
    "n_replayed": {
      "type": "integer"
    },
    "agreement_rate": {
      "type": "number"
    },
    "disagreements": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "cost_before_month_usd": {
      "description": "null si non mesurable (modele hors catalogue, usage inconnu) : jamais de valeur par defaut.",
      "type": ["number", "null"]
    },
    "cost_after_month_usd": {
      "description": "null si non mesurable.",
      "type": ["number", "null"]
    },
    "cost_factor": {
      "description": "null si l'un des deux couts est null.",
      "type": ["number", "null"]
    },
    "p95_before_ms": {
      "type": "number"
    },
    "p95_after_ms": {
      "type": "number"
    },
    "threshold": {
      "type": "number"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "reject"
      ]
    }
  }
}