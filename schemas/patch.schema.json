{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "patch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "patch_id",
    "finding_id",
    "workflow_id",
    "strategy",
    "diff_summary",
    "coverage_estimate",
    "patched_workflow"
  ],
  "properties": {
    "patch_id": {
      "type": "string"
    },
    "finding_id": {
      "type": "string"
    },
    "workflow_id": {
      "type": "string"
    },
    "strategy": {
      "type": "string",
      "enum": [
        "rule_switch",
        "downgrade",
        "cache",
        "bound_loop"
      ]
    },
    "diff_summary": {
      "type": "string"
    },
    "coverage_estimate": {
      "type": "number"
    },
    "patched_workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "nodes",
        "connections",
        "settings"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "connections": {
          "type": "object"
        },
        "settings": {
          "type": "object"
        }
      }
    }
  }
}