# Copier en .env.local et remplir. .env.local n'est jamais commite.
# Cles sponsors du weekend : ne jamais les coller dans un fil de discussion.

# Passerelle
GATEWAY_PORT=8080
# GATEWAY_HOST=127.0.0.1
# GATEWAY_OPENAI_UPSTREAM=https://api.openai.com

# Fournisseurs (tests en direct et enregistrement des reponses)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Prototype hackathon (run.sh), inutile pour la passerelle
N8N_URL=
N8N_API_KEY=
SLACK_WEBHOOK_URL=

# Agent auditeur (A1) : sans clé, make audit produit le rapport sans agent.
# Clé du client : l'audit tourne chez lui, ses données ne passent pas par Deadweight.
DW_LLM_API_KEY=
# DW_LLM_BASE_URL=https://api.openai.com/v1
# DW_AGENT_MODEL=gpt-5-mini
